<Project Sdk="Uno.Sdk">
 <PropertyGroup>
  <TargetFrameworks>net10.0-browserwasm</TargetFrameworks>
  <OutputType>Exe</OutputType><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  <ApplicationTitle>mise. — App Anatomy</ApplicationTitle><ApplicationId>app.anatomy.mise</ApplicationId>
  <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion><ApplicationVersion>1</ApplicationVersion>
  <WasmShellMonoRuntimeExecutionMode>Interpreter</WasmShellMonoRuntimeExecutionMode>
  <WasmShellEnableThreads>false</WasmShellEnableThreads><WasmShellWebAppBasePath>./</WasmShellWebAppBasePath>
  <PublishTrimmed>false</PublishTrimmed><JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  <UnoFeatures></UnoFeatures>
 </PropertyGroup>
 <ItemGroup>
  <EmbeddedResource Include="WasmScripts/anatomy.js" />
  <Content Include="Assets/coffee.png" />
  <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
 </ItemGroup>
</Project>
